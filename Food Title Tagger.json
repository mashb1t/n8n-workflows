        "inputSchema": "{\n\t\"type\": \"object\",\n\t\"properties\": {\n\t\t\"is_food\": { \"type\": \"boolean\" },\n\t\t\"diet\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"enum\": [\"vegan\", \"vegetarian\", \"non-vegetarian\"],\n\t\t\t\"description\": \"dietary classification of the food\"\n\t\t},\n\t\t\"category\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"enum\": [\"appetizer\", \"main dish\", \"dessert\", \"other\"],\n\t\t\t\"description\": \"the category of the food\"\n\t\t},\n\t\t\"food_description_english\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"describe the food in english by mentioning its name and any ingredient(s) if possible. Max. 100 characters.\"\n\t\t},\n\t\t\"food_description_german\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"describe the food in german by mentioning its name and any ingredient(s) if possible. Max. 100 characters.\"\n\t\t},\n\t\t\"ingredients\": {\n\t\t\t\"type\": \"array\",\n\t\t\t\"items\": { \"type\": \"string\" }\n\t\t}\n\t}\n}",
