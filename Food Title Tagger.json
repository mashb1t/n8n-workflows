    {
      "parameters": {
        "jsCode": "// Loop over input items and build a tags array from category + diet + ingredients\nfor (const item of $input.all()) {\n  const out = item.json.output;\n  out.tags = [...out.ingredients];\n\n  if (out.diet === \"vegan\" || out.diet === \"vegetarian\") {\n    out.tags.push(out.diet);\n  }\n\n  if (out.category && out.category !== \"other\") {\n    out.tags.push(out.category);\n  }\n}\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
