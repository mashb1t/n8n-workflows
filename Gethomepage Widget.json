    {
      "parameters": {
        "jsCode": "const cutoff = Date.now() - 24 * 60 * 60 * 1000;\n\n// IDs to exclude — the gethomepage widget executions\nconst excludeIds = new Set(\n  $('Gethomepage Executions').all().map(it => String(it.json.id))\n);\n\nconst items = $('All Executions').all();\nlet executions24h = 0;\nlet failed24h = 0;\nfor (const it of items) {\n  const e = it.json;\n  if (excludeIds.has(String(e.id))) continue;          // drop the overlap\n  const ts = Date.parse(e.startedAt || e.stoppedAt || e.createdAt || \"\");\n  if (Number.isNaN(ts) || ts < cutoff) continue;\n  executions24h += 1;\n  if (e.status === \"error\") failed24h += 1;\n}\nreturn [\n  {\n    json: {\n      executions_24h: executions24h,\n      executions_failed_24h: failed24h\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
